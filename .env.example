# Local development defaults to mock. Production is fixed to supabase in
# netlify.toml; Deploy Preview must explicitly choose mock or supabase.
# All non-VITE server variables must be configured with Netlify Functions scope.
VITE_DATA_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANALYSIS_MODEL_MODE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ALLOWED_HOSTS=
OPENAI_MODEL=
ANALYSIS_INTERNAL_SECRET=
ANALYSIS_CALLBACK_ORIGIN=
ANALYSIS_MODEL_TIMEOUT_MS=45000
ANALYSIS_MAX_RESPONSE_BYTES=524288
ANALYSIS_MAX_OUTPUT_TOKENS=2000
ANALYSIS_MAX_RETRY_DELAY_MS=60000
ANALYSIS_USER_DAILY_LIMIT=5
ANALYSIS_ADMIN_RETRY_COOLDOWN_SECONDS=300
ANALYSIS_ADMIN_DAILY_RETRY_LIMIT=10
ANALYSIS_RECONCILE_BUDGET_MS=50000
ANALYSIS_RECONCILE_JOB_LIMIT=5
MIN_AGGREGATE_SAMPLE_SIZE=3
